{
  "uid": "harness-agent-slo",
  "title": "Harness Agent SLO / 容量 / 成本",
  "tags": ["harness-agent", "slo", "capacity", "cost"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "可用性（1h，SLO 99.9%）",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(harness_api_requests_total{status!~\"5..\"}[1h])) / clamp_min(sum(rate(harness_api_requests_total[1h])), 0.0001)",
        "legendFormat": "availability"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 3}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LLM 费用 / 小时",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum(rate(harness_agent_llm_cost_total[1h])) * 3600",
        "legendFormat": "cost/hour"
      }],
      "fieldConfig": {"defaults": {"unit": "currencyUSD", "decimals": 2}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "SSE 连接",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "harness_agent_sse_connections",
        "legendFormat": "connections"
      }],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "在途 Job",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum(harness_agent_jobs_inflight)",
        "legendFormat": "inflight"
      }],
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "API 5xx 比例（按 route）",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (route) (rate(harness_api_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (route) (rate(harness_api_requests_total[5m])), 0.0001)",
        "legendFormat": "{{route}}"
      }],
      "fieldConfig": {"defaults": {"unit": "percentunit", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "API P95 延迟",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "histogram_quantile(0.95, sum by (le) (rate(harness_api_request_duration_seconds_bucket[5m])))",
        "legendFormat": "p95"
      }],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Run 吞吐（按 mode/status）",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (mode,status) (rate(harness_agent_runs_total[5m]))",
        "legendFormat": "{{mode}}/{{status}}"
      }],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "LLM Token（按 mode/kind）",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{
        "refId": "A",
        "expr": "sum by (mode,kind) (rate(harness_agent_llm_tokens_total[5m]))",
        "legendFormat": "{{mode}}/{{kind}}"
      }],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Job 结果与 Outbox 结果",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 19},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type,outcome) (rate(harness_agent_jobs_total[5m]))",
          "legendFormat": "job {{type}}/{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum by (event_type,outcome) (rate(harness_agent_outbox_events_total[5m]))",
          "legendFormat": "outbox {{event_type}}/{{outcome}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "工具调用、记忆失败与资源",
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 19},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool,status) (rate(harness_agent_tool_calls_total[5m]))",
          "legendFormat": "tool {{tool}}/{{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (operation,outcome) (rate(harness_agent_memory_operations_total[5m]))",
          "legendFormat": "memory {{operation}}/{{outcome}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "数据库连接池与等待",
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 26},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "harness_db_pool_in_use_connections",
          "legendFormat": "in use {{pool}}"
        },
        {
          "refId": "B",
          "expr": "harness_db_pool_max_open_connections",
          "legendFormat": "max {{pool}}"
        },
        {
          "refId": "C",
          "expr": "rate(harness_db_pool_wait_total[5m])",
          "legendFormat": "waits/s {{pool}}"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10}}, "overrides": []}
    }
  ]
}
